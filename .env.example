# ============================================================
# SunDash 环境变量模板
# 复制为 .env 后填入真实值：
#   cp .env.example .env
# ============================================================

# ── 必填 ────────────────────────────────────────────────────
# JWT 签名密钥：服务未设置时拒绝启动。生成随机长密钥：
#   openssl rand -base64 48
SUNDASH_JWT_SECRET=change-me-to-a-long-random-string

# ── 可选 ────────────────────────────────────────────────────
# 监听端口（默认 3000）
# SUNDASH_PORT=3000

# 数据目录（SQLite 数据库 sundash.db 所在目录，默认 ./data）
# SUNDASH_DATA_DIR=/app/data

# 时区（默认 Asia/Shanghai）
# TZ=Asia/Shanghai

# 调试模式：true 时使用开发 JWT 密钥（仅限开发环境！）
# SUNDASH_DEBUG=true

# CORS 白名单（逗号分隔；留空 = 仅同源）
# SUNDASH_ALLOWED_ORIGINS=

# MCP（AI 助手）访问令牌：配置后 AI 客户端调用 /mcp 需携带
# Authorization: Bearer <token>
# SUNDASH_MCP_TOKEN=

# MCP 令牌绑定的用户（默认 admin）
# SUNDASH_MCP_USERNAME=admin
