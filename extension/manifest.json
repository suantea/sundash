{
  "manifest_version": 3,
  "name": "SunDash Monitor",
  "version": "0.1.0",
  "description": "页面内容监控与静默刷新 - 配合 SunDash 面板使用",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/monitor.js"],
      "run_at": "document_idle"
    }
  ]
}
